# =============================================================================
# 🚀 CODESTER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
#
# QUICK START (minimum required to boot locally):
#   NODE_ENV=development
#   PORT=3001
#   MONGO_URI=mongodb://localhost:27017/codester
#   REDIS_URL=redis://localhost:6379   # (optional if code paths tolerate absence)
#   JWT_SECRET=replace-with-long-random-string
#   ADMIN_EMAIL=you@example.com
#   COMPILER_SERVICE_URL=http://localhost:8000   # or your deployed compiler URL
#
# Then run backend & frontend; add GEMINI_API_KEY only if you want AI features.

# =============================================================================
# 🌐 SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
## Primary MongoDB connection (Atlas or local). Required.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

## Alternative MongoDB URIs (diagnostic endpoints /db/* use these for connectivity tests)
MONGO_DIRECT_URI=mongodb://localhost:27017/codester
MONGO_CLUSTER_URI=mongodb://localhost:27017/codester

# =============================================================================
# 🔴 REDIS CONFIGURATION
# =============================================================================
## Redis (optional at dev; required for caching + rate limiting/AI hint cache in prod)
REDIS_URL=redis://localhost:6379

# =============================================================================
# 🔐 AUTHENTICATION
# =============================================================================
## JWT secret (generate 32+ random chars: e.g. `openssl rand -hex 32`)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

## Token lifetime (examples: 15m, 1h, 12h, 7d)
JWT_EXPIRES_IN=7d

## Admin configuration
# Use either a single ADMIN_EMAIL or a comma list in ADMIN_EMAILS. Both are checked.
# ADMIN_CODES are optional codes that can promote a normal account (if you expose that feature).
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=vikrantkawadkar2099@gmail.com
ADMIN_CODES=ADMIN2024,SUPERADMIN

# =============================================================================
# 🤖 AI SERVICE CONFIGURATION
# =============================================================================
## Google Gemini AI API Key (leave blank to disable AI features gracefully)
GEMINI_API_KEY=

# =============================================================================
# ⚙️ COMPILER SERVICE CONFIGURATION
# =============================================================================
## Primary compiler service URL (Azure / container). For local dev comment & use localhost
COMPILER_SERVICE_URL=http://4.187.155.173:80

## Optional fallback compiler endpoint (used if primary is unhealthy)
COMPILER_SERVICE_URL_FALLBACK=

# Local development fallback
# COMPILER_SERVICE_URL=http://localhost:8000

# =============================================================================
# 🌍 CORS CONFIGURATION
# =============================================================================
## Allowed frontend origins (comma separated, no spaces)
CORS_ORIGINS=https://online-judge-codester.vercel.app,http://localhost:5173

# =============================================================================
# 📧 EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =============================================================================
# 📱 APPWRITE CONFIGURATION (Optional)
# =============================================================================
# APPWRITE_PROJECT_ID=your-project-id
# APPWRITE_API_KEY=your-api-key
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# =============================================================================
# 🔍 MONITORING & LOGGING
# =============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-for-error-tracking

# =============================================================================
# 🚀 DEPLOYMENT CONFIGURATION
# =============================================================================
# Set to 'true' for production optimizations
PRODUCTION_MODE=true

# Health check intervals (in milliseconds)
HEALTH_CHECK_INTERVAL=30000
COMPILER_HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# 🧪 SEEDING & DEVELOPMENT UTILITIES
# =============================================================================
## Seeding & development helpers
# SEED_TEST_USERS=true will auto create sample accounts/problems if logic enabled.
# Keep false in production to avoid accidental admin/test clutter.
SEED_TEST_USERS=false
SEED_USERS_KEY=SEED_USERS_2025

# =============================================================================
# ⚠️ SECURITY NOTES
# =============================================================================
# 1. Never commit a real .env file.
# 2. Rotate JWT_SECRET if exposed.
# 3. Leave GEMINI_API_KEY empty to disable AI endpoints (they return 503 with message).
# 4. ADMIN_* settings grant elevated privileges; rotate if leaked.
# 5. Never reuse JWT_SECRET / SEED_USERS_KEY across environments.
# 6. For containers, set secrets in the platform dashboard, not baked in images.

# =============================================================================
# ✅ VALIDATION CHECKLIST (delete after setup)
#  - Can connect to MongoDB (see /api/health or logs)
#  - Redis connected (optional dev) for leaderboard + caching
#  - Compiler service reachable (/api/execute returns output)
#  - Admin login shows Admin panel
#  - AI review returns 503 gracefully if GEMINI_API_KEY unset
# =============================================================================
